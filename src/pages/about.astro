---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import AboutSideNav from "../components/about/AboutSideNav.astro";
import MainBio from "../components/about/MainBio.astro";
import Story from "../components/about/Story.astro";
import Work from "../components/about/Work.astro";
import LetsTalk from "../components/LetsTalk.astro";
import Contact from "../components/Contact.astro";
---

<Layout
  title="About Arushima — Product & UI/UX Designer"
  description="Meet Arushima, a New Delhi product and UI/UX designer with experience at Zomato, Samsung R&D, and design teams across mobile products and visual systems."
  background="grid"
>
  <Nav active="about" />
  <AboutSideNav />

  <main id="main-content">
    <header id="top" class="max-w-[860px] mx-auto px-5 pt-[50px] pb-4">
      <h1 class="font-pixel m-0 leading-[0.9]" style="font-size:clamp(56px,12vw,120px);">
        ABOUT
      </h1>
    </header>

    <MainBio />
    <Story />
    <Work />
    <LetsTalk />
    <Contact />
  </main>

  <Footer />
</Layout>

<script>
  import "../scripts/reveal";
</script>
