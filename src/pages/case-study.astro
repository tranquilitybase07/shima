---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CaseHeader from "../components/casestudy/CaseHeader.astro";
import MoreProjects from "../components/casestudy/MoreProjects.astro";
import LetsTalk from "../components/LetsTalk.astro";
import Contact from "../components/Contact.astro";
---

<Layout
  title="Case Studies — Arushima"
  description="Explore Arushima's product design, UI/UX, and brand identity case studies."
  image="/hatching-app.png"
  imageAlt="A selection of Arushima's product design and UI/UX case studies"
  background="ruled"
>
  <Nav active="work" />

  <main id="main-content">
    <CaseHeader />
    <MoreProjects />
    <LetsTalk />
    <Contact />
  </main>

  <Footer />
</Layout>

<script>
  import "../scripts/reveal";
</script>
