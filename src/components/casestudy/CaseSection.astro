---
import ImageSlot from "../ImageSlot.astro";
import type { Section } from "../../data/casestudy";

interface Props {
  section: Section;
}
const { section } = Astro.props;
---

<section class="max-w-[900px] mx-auto px-5 py-8">
  <div class="text-center max-w-[520px] mx-auto mb-6">
    <h2 class="font-script text-[24px] text-ink mb-2">{section.heading}</h2>
    <p class="text-[13px] leading-[1.6] text-ink/80">{section.body}</p>
  </div>

  <div
    class:list={[
      "grid gap-4",
      section.layout === "duo" ? "sm:grid-cols-2" : "grid-cols-1",
    ]}
  >
    {
      section.slots.map((s) => (
        <div
          class="relative border-[1.5px] border-ink rounded-[6px] overflow-hidden shadow-hard-3"
          style={`height:${section.layout === "solo" ? "360px" : "270px"};`}
        >
          <ImageSlot id={s.id} shape="rect" placeholder={s.placeholder} />
        </div>
      ))
    }
  </div>
</section>
