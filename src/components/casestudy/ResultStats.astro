---
import ImageSlot from "../ImageSlot.astro";
import { results, stats } from "../../data/casestudy";
---

<section class="max-w-[900px] mx-auto px-5 py-8">
  <div class="text-center max-w-[560px] mx-auto mb-6">
    <h2 class="font-script text-[24px] text-ink mb-2">{results.heading}</h2>
    <p class="text-[13px] leading-[1.6] text-ink/80">{results.body}</p>
  </div>

  <!-- Stat notes -->
  <div class="flex flex-wrap justify-center gap-4 mb-8">
    {
      stats.map((st, i) => (
        <div
          class="border-[1.5px] border-ink rounded-[8px] px-4 py-3 w-[180px] shadow-hard-2 flex flex-col"
          style={`background:${st.bg};transform:rotate(${i % 2 === 0 ? -1.5 : 1.5}deg);`}
        >
          <div
            class:list={["font-bold leading-[1.1]", st.text ? "text-[15px]" : "text-[30px]"]}
          >
            {st.big}
          </div>
          {st.small && (
            <div class="text-[11px] text-ink/70 mt-1 leading-[1.3]">{st.small}</div>
          )}
          <div class="mt-auto pt-2 font-mono text-[9px] font-bold tracking-[0.1em] text-ink/70">
            {st.label}
          </div>
        </div>
      ))
    }
  </div>

  <!-- Result images -->
  <div class="grid gap-4 sm:grid-cols-2">
    {
      results.slots.map((s) => (
        <div
          class="relative border-[1.5px] border-ink rounded-[6px] overflow-hidden shadow-hard-3"
          style="height:270px;"
        >
          <ImageSlot id={s.id} shape="rect" placeholder={s.placeholder} />
        </div>
      ))
    }
  </div>
</section>
