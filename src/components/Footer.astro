---
import { name } from "../data/portfolio";
import SocialIcon from "./SocialIcon.astro";

const links = [
  { href: "/about", label: "ABOUT" },
  { href: "/case-study", label: "CASE STUDY" },
];
---

<footer class="relative mt-10">
  <!-- Decorative arc across the top -->
  <svg
    viewBox="0 0 1200 90"
    preserveAspectRatio="none"
    class="block w-full h-[70px]"
    aria-hidden="true"
  >
    <path d="M0,82 C350,4 850,4 1200,82" fill="none" stroke="#a99a78" stroke-width="1.25" />
  </svg>

  <div class="max-w-[1200px] mx-auto px-6 pt-2 pb-[46px]">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div>
        <div class="font-pixel leading-[0.9] uppercase" style="font-size:clamp(34px,6vw,64px);">
          {name}
        </div>
        <div class="font-mono text-[12px] font-bold tracking-[0.14em] mt-3 flex items-center gap-2">
          <span class="text-blue">●</span> PRODUCT DESIGNER
        </div>
      </div>

      <div class="flex flex-col items-start sm:items-end gap-5">
        <nav class="flex items-center gap-7 font-mono text-[13px] font-bold tracking-[0.14em]">
          {links.map((l) => (
            <a href={l.href} class="hover:text-blue transition-colors">{l.label}</a>
          ))}
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="grid place-items-center w-[42px] h-[42px] rounded-full border-[1.5px] border-ink shadow-hard-2"
            style="background:#F4C020;color:#111;"
          >
            <SocialIcon name="linkedin" />
          </a>
          <a
            href="https://dribbble.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Dribbble"
            class="grid place-items-center w-[42px] h-[42px] rounded-full border-[1.5px] border-ink shadow-hard-2"
            style="background:#EC1E79;color:#fff;"
          >
            <SocialIcon name="dribbble" />
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="grid place-items-center w-[42px] h-[42px] rounded-full border-[1.5px] border-ink shadow-hard-2"
            style="background:#8BD450;color:#111;"
          >
            <SocialIcon name="instagram" />
          </a>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 mt-10 font-mono text-[11px] tracking-[0.06em] text-ink/60">
      <span>© 2026 Arushima</span>
      <span class="inline-flex items-center gap-2 bg-[#e7dfca] border-[1.5px] border-ink rounded-full px-4 py-[8px] text-ink font-bold shadow-hard-2">
        ✦ BUILT WITH ASTRO
      </span>
    </div>
  </div>
</footer>
