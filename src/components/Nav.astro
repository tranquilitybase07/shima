---
// Sticky top navigation, shared across pages.
// `active` highlights the current page's link with its accent color.
interface Props {
  active?: "home" | "about" | "work" | "playground";
}
const { active = "home" } = Astro.props;

const links = [
  { key: "home", href: "/", label: "HOME", icon: "★", accent: "#3AC7F0" },
  { key: "about", href: "/about", label: "ABOUT", icon: "✦", accent: "#F4C020" },
  { key: "work", href: "/case-study", label: "CASE STUDY", icon: "▤", accent: "#8BD450" },
  { key: "playground", href: "/#top", label: "PLAYGROUND", icon: "◆", accent: "#B98BE8" },
];

const socials = [
  { href: "https://linkedin.com", label: "in", bg: "#3AC7F0" },
  { href: "https://dribbble.com", label: "Dr", bg: "#EC1E79" },
  { href: "https://github.com", label: "gh", bg: "#8BD450" },
];
---

<nav
  class="sticky top-0 z-60 flex items-center justify-between bg-paper px-[18px] py-[10px] border-b-[1.5px] border-ink font-mono text-[11px] tracking-[0.05em]"
>
  <div class="flex items-center gap-[6px]">
    <span
      class="grid place-items-center w-[26px] h-[26px] rounded-full border-[1.5px] border-ink text-[11px] font-bold shrink-0"
      style="background:#EC1E79;color:#fff;"
      aria-hidden="true">A</span
    >
    {
      links.map((l) => {
        const isActive = l.key === active;
        return (
          <a
            href={l.href}
            class="flex items-center gap-[5px] px-[9px] py-[5px] font-bold rounded-[6px]"
            style={
              isActive
                ? `background:${l.accent};border:1.5px solid #111;`
                : undefined
            }
          >
            <span aria-hidden="true">{l.icon}</span>
            {l.label}
          </a>
        );
      })
    }
  </div>
  <div class="flex items-center gap-[8px]">
    {
      socials.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          class="grid place-items-center w-[30px] h-[30px] rounded-full border-[1.5px] border-ink text-[11px] font-bold"
          style={`background:${s.bg};color:#fff;`}
        >
          {s.label}
        </a>
      ))
    }
    <a
      href="#contact"
      class="flex items-center gap-[5px] bg-paper border-[1.5px] border-ink rounded-[6px] px-[11px] py-[6px] font-bold"
      >♥ CONTACT</a
    >
  </div>
</nav>
