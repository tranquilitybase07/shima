---
import { name, tagline } from "../data/portfolio";
---

<header id="top" class="relative flex flex-col px-5">
  <!-- Hero content vertically centered as one balanced block -->
  <div class="grid place-items-center" style="min-height:calc(100dvh - 53px);">
    <div class="w-full">
      <!-- NAME GROUP -->
      <div class="relative w-full text-center">
        <!-- Sticker labels flanking the wordmark (animated by floaters.ts) -->
        <div
          data-float
          data-rot="-11"
          class="absolute left-[9%] -top-[6px] bg-yellow border-[1.5px] border-ink px-3 py-[5px] font-script text-[19px] shadow-hard-2"
          style="transform:rotate(-11deg);"
        >
          Currently at Zomato
        </div>
        <div
          data-float
          data-rot="9"
          class="absolute right-[11%] -top-[4px] bg-pink text-paper border-[1.5px] border-ink px-3 py-[5px] font-script text-[19px] shadow-hard-2"
          style="transform:rotate(9deg);"
        >
          Always shipping
        </div>

        <div class="font-script text-[22px] mb-[2px]" style="transform:rotate(-2deg);">
          my name is
        </div>

        <div
          class="relative inline-block px-[26px] py-[6px] my-[4px] mb-[14px] border-2 border-dashed"
          style="border-color:#6b6bff;"
        >
          <h1
            class="font-pixel m-0 leading-[0.95] tracking-[0.02em] uppercase"
            style="font-size:clamp(60px,10vw,132px);"
          >
            {name}
          </h1>
          <span class="absolute -left-[7px] -top-[7px] w-3 h-3" style="background:#6b6bff;"></span>
          <span class="absolute -right-[7px] -top-[7px] w-3 h-3" style="background:#6b6bff;"></span>
          <span class="absolute -left-[7px] -bottom-[7px] w-3 h-3" style="background:#6b6bff;"></span>
          <span class="absolute -right-[7px] -bottom-[7px] w-3 h-3" style="background:#6b6bff;"></span>
        </div>

        <div class="font-mono text-[12px] tracking-[0.12em] text-mint">
          ● AVAILABLE FOR THOUGHTFUL PROJECTS
        </div>
      </div>

    <!-- TAGLINE GROUP — pills flank the tagline -->
    <div class="relative w-full text-center mt-[44px]">
      <div
        data-float
        data-rot="-8"
        class="absolute left-[6%] top-[6px] bg-blue border-[1.5px] border-ink rounded-[40px] px-[14px] py-[6px] font-mono text-[11px] font-bold shadow-hard-2"
        style="transform:rotate(-8deg);"
      >
        ✎ PRODUCT DESIGNER ➛
      </div>
      <div
        data-float
        data-rot="7"
        class="absolute right-[7%] top-[44px] bg-pink text-paper border-[1.5px] border-ink rounded-[40px] px-[14px] py-[6px] font-mono text-[11px] font-bold shadow-hard-2"
        style="transform:rotate(7deg);"
      >
        Delhi, India ✦
      </div>

      <h2
        class="font-semibold max-w-[640px] mx-auto mb-[22px] leading-[1.25]"
        style="font-size:clamp(24px,3.4vw,38px);"
      >
        {tagline}
      </h2>

      <a
        href="#contact"
        class="inline-flex items-center gap-2 bg-blue border-[1.5px] border-ink rounded-[8px] px-5 py-[11px] font-mono font-bold text-[13px] shadow-hard-3"
        >✦ CONTACT ME</a
      >
      </div>
    </div>
  </div>

  <!-- Divider curve sits at the fold, just below the hero -->
  <svg
    viewBox="0 0 1200 80"
    preserveAspectRatio="none"
    class="block w-full h-[70px] shrink-0"
  >
    <path d="M0,70 C300,10 900,10 1200,70" fill="none" stroke="#111" stroke-width="1.5"></path>
  </svg>
</header>
