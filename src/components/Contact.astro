---
import { firstName, contact } from "../data/portfolio";
import ImageSlot from "./ImageSlot.astro";
---

<section id="contact" class="relative max-w-[1000px] mx-auto px-5 mt-6 mb-[90px]">
  <!-- Big yellow call-to-action card -->
  <div
    class="relative bg-yellow border-[2.5px] border-ink rounded-[20px] px-6 py-[clamp(52px,8vw,96px)] text-center"
    style="transform:rotate(-1deg);box-shadow:9px 9px 0 #111;"
  >
    <span
      class="tape hidden sm:block"
      style="top:-11px;left:38px;background:rgba(244,192,32,.6);transform:rotate(-8deg);"
    ></span>
    <span
      class="tape hidden sm:block"
      style="top:-11px;right:42px;background:rgba(236,30,121,.4);transform:rotate(7deg);"
    ></span>

    <div class="font-script leading-none mb-1" style="font-size:clamp(20px,2.5vw,30px);">
      let's make something together
    </div>
    <div
      class="font-pixel uppercase leading-[0.9]"
      style="font-size:clamp(52px,13vw,132px);"
    >
      CONTACT
    </div>
    <a
      href="#top"
      class="inline-flex items-center gap-2 mt-6 font-mono font-bold tracking-[0.12em] text-[13px] border-b-2 border-ink pb-[3px]"
    >
      DROP A LINE ↗
    </a>
  </div>

  <!-- Pinned profile sticky note -->
  <div
    class="hidden md:block absolute left-[2%] -top-[26px] z-[3] w-[264px] border-[1.5px] border-ink/40 shadow-hard-3 p-[16px]"
    style="transform:rotate(-6deg);background:#B7C4F5;"
  >
    <span
      class="tape"
      style="top:-11px;left:22px;background:rgba(244,192,32,.55);transform:rotate(-10deg);"
    ></span>
    <span
      class="tape"
      style="top:-11px;right:26px;background:rgba(236,30,121,.35);transform:rotate(8deg);"
    ></span>
    <div class="flex gap-3">
      <div
        class="relative w-[42px] h-[42px] rounded-full overflow-hidden border-[1.5px] border-ink shrink-0"
      >
        <ImageSlot id="talk_avatar" src="/its-me.jpg" shape="circle" placeholder="" />
      </div>
      <div>
        <div class="font-bold text-[13px] leading-tight">{firstName}</div>
        <div class="text-[12px] leading-[1.45] text-ink/75 mt-1">{contact}</div>
      </div>
    </div>
    <div
      class="mt-3 inline-flex items-center gap-1 bg-paper border-[1.5px] border-ink rounded-[6px] px-[8px] py-[2px] font-mono text-[11px] font-bold"
    >
      ⚡ 1
    </div>
  </div>
</section>
