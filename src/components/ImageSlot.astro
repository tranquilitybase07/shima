---
// Static stand-in for the DC runtime's <image-slot> web component.
// Renders the photo when `src` is supplied, otherwise a neutral
// placeholder matching the original empty state.
interface Props {
  id?: string;
  src?: string;
  alt?: string;
  placeholder?: string;
  shape?: "rect" | "rounded" | "circle" | "pill";
  radius?: number;
  class?: string;
}

const {
  id,
  src,
  alt = "",
  placeholder = "Drop an image",
  shape = "rounded",
  radius = 12,
  class: className = "",
} = Astro.props;

const radiusMap: Record<string, string> = {
  rect: "0",
  rounded: `${radius}px`,
  circle: "50%",
  pill: "9999px",
};
const borderRadius = radiusMap[shape] ?? `${radius}px`;
---

<div
  id={id}
  class:list={["image-slot", className]}
  style={`border-radius:${borderRadius};`}
>
  {
    src ? (
      <img src={src} alt={alt} style={`border-radius:${borderRadius};`} />
    ) : (
      <div class="image-slot__ph" aria-label={placeholder}>
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <circle cx="8.5" cy="8.5" r="1.6" />
          <path d="M21 15l-5-5L5 21" />
        </svg>
        <span>{placeholder}</span>
      </div>
    )
  }
</div>

<style>
  .image-slot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #e8e8e8;
  }
  .image-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .image-slot__ph {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #8a8a8a;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    user-select: none;
  }
</style>
