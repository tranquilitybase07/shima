---
import { bio, skills } from "../data/portfolio";
import ImageSlot from "./ImageSlot.astro";

// Deliberately mismatched icon rectangle sizes for a playful, hand-placed feel
const iconSizes = [
  { w: 34, h: 20 },
  { w: 18, h: 30 },
  { w: 28, h: 26 },
  { w: 22, h: 14 },
];
---

<section
  id="about"
  class="relative flex flex-col items-center justify-center text-center px-5 py-[70px]"
  style="min-height:calc(100dvh - 53px);"
>
  <div
    class="absolute left-[6%] top-[40px] font-script text-[22px]"
    style="transform:rotate(-4deg);"
  >
    next me ↴
  </div>

  <!-- Left polaroid — anchored just left of the centered text column -->
  <div
    class="absolute left-1/2 top-1/2 bg-paper border-[1.5px] border-ink px-[10px] pt-[10px] pb-[30px] shadow-hard-4 w-[180px] hidden xl:block"
    style="transform:translate(-610px,-50%) rotate(-7deg);"
  >
    <div class="relative w-full h-[150px]">
      <ImageSlot id="polaroid_left" src="/its-me.jpg" alt="Arushima" shape="rect" placeholder="me" />
    </div>
    <div class="font-script text-[17px] mt-2">it's me</div>
  </div>

  <!-- Right polaroid — anchored just right of the centered text column -->
  <div
    class="absolute left-1/2 top-1/2 bg-paper border-[1.5px] border-ink px-[10px] pt-[10px] pb-[30px] shadow-hard-4 w-[180px] hidden xl:block"
    style="transform:translate(430px,-50%) rotate(6deg);"
  >
    <div class="relative w-full h-[150px]">
      <ImageSlot id="polaroid_right" shape="rect" placeholder="workspace" />
    </div>
    <div class="font-script text-[17px] mt-2">my workspace</div>
  </div>

  <div
    data-reveal
    class="inline-block border-[1.5px] border-ink px-5 py-[8px] font-semibold text-[18px] mb-[clamp(28px,5vh,56px)] shadow-hard-2 bg-paper"
  >
    what's up
  </div>

  <p
    class="font-semibold leading-[1.3] mx-auto max-w-[820px] [text-wrap:balance]"
    style="font-size:clamp(20px,2.6vw,34px);"
  >
    {bio[0]}
    <span
      class="inline-block w-[clamp(26px,2.4vw,34px)] h-[clamp(20px,1.9vw,28px)] bg-yellow border-[1.5px] border-ink rounded-[6px] align-middle"
    ></span>
    {bio[1]}
    <span
      class="inline-block w-[clamp(22px,2vw,30px)] h-[clamp(22px,2vw,30px)] bg-pink rounded-full align-middle"
    ></span>
  </p>

  <div
    class="grid grid-cols-1 sm:grid-cols-2 gap-[14px] mt-[clamp(32px,5vh,60px)] w-full max-w-[720px] mx-auto"
  >
    {
      skills.map((s, i) => (
        <div
          data-reveal
          class="flex items-center justify-between gap-3 border-[1.5px] border-ink rounded-[8px] px-5 py-[13px] font-semibold text-[clamp(18px,2vw,24px)] shadow-hard-3"
          style={`background:${s.bg};color:${s.fg};--reveal-delay:${i * 90}ms;`}
        >
          <span>{s.name}</span>
          <span
            class="inline-block rounded-[4px] opacity-85 shrink-0"
            style={`background:${s.fg};width:${iconSizes[i % iconSizes.length].w}px;height:${iconSizes[i % iconSizes.length].h}px;`}
          />
        </div>
      ))
    }
  </div>
</section>
