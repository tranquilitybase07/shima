---
import { firstName } from "../../data/portfolio";

const comment =
  "Open to contract work, full-time roles, and interesting conversations about hard design problems.";
---

<section id="contact" class="relative max-w-[860px] mx-auto mb-16 px-5">
  <!-- Floating comment card -->
  <div
    class="absolute left-[26px] -top-[26px] z-[3] bg-[#C9D2F5] border-[1.5px] border-ink rounded-[10px] p-[12px_14px] w-[230px] shadow-hard-3"
    style="transform:rotate(-2deg);"
  >
    <span class="tape" style="left:80px;top:-11px;background:rgba(244,192,32,.6);"></span>
    <div class="flex gap-2">
      <div
        class="w-[26px] h-[26px] rounded-full bg-pink border-[1.5px] border-ink shrink-0 grid place-items-center text-[10px] font-bold text-paper"
      >
        {firstName[0]}
      </div>
      <div>
        <div class="font-bold text-[12px]">{firstName} Vale</div>
        <div class="text-[11px] leading-[1.4] text-ink/70">{comment}</div>
      </div>
    </div>
    <div class="mt-2 font-mono text-[10px]">⬇ 1</div>
  </div>

  <!-- CTA panel -->
  <div
    class="relative border-[1.5px] border-ink rounded-[16px] bg-yellow shadow-hard-6 px-6 py-[50px]"
  >
    <div class="md:pl-[38%]">
      <div class="font-script text-[19px] mb-1">let's make something together</div>
      <a href="mailto:hello@arushima.design" class="inline-block">
        <span
          class="font-display block"
          style="font-size:clamp(40px,8vw,84px);line-height:0.95;">CONTACT</span
        >
      </a>
      <div class="mt-3">
        <a
          href="mailto:hello@arushima.design"
          class="inline-flex items-center gap-2 font-mono text-[12px] font-bold tracking-[0.08em] border-b-[1.5px] border-ink pb-[2px]"
          >DROP A LINE ↗</a
        >
      </div>
    </div>
  </div>
</section>
