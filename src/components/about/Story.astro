---
import SectionTag from "../SectionTag.astro";
import { storyCards } from "../../data/about";
---

<section id="story" class="max-w-[860px] mx-auto px-5 py-10 scroll-mt-[70px]">
  <div class="mb-5">
    <SectionTag bg="#EC1E79" fg="#fff" icon="◆">STORY</SectionTag>
  </div>

  <div
    class="relative border-[1.5px] border-dashed border-pink rounded-[16px] px-5 py-8 md:px-10"
  >
    <div class="flex flex-col gap-9">
      {
        storyCards.map((c, i) => (
          <div class="relative flex items-center gap-4">
            <div
              class="relative border-[1.5px] border-ink rounded-[6px] px-5 py-4 shadow-hard-3 w-full max-w-[380px]"
              style={`background:${c.bg};color:${c.fg};transform:rotate(${i % 2 === 0 ? -1 : 1}deg);`}
            >
              <span
                class="tape"
                style="left:calc(50% - 29px);top:-11px;background:rgba(17,17,17,.14);"
              />
              <h3 class="font-semibold text-[18px] m-0 mb-2">{c.title}</h3>
              <p class="text-[13px] leading-[1.55] m-0 opacity-90">{c.body}</p>
            </div>

            <!-- Handwritten annotation with a little arrow -->
            <div class="hidden md:flex items-center gap-2 shrink-0">
              <svg width="46" height="26" viewBox="0 0 46 26" fill="none" aria-hidden="true">
                <path
                  d="M45 20 C30 24, 14 20, 3 8"
                  stroke="#111"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
                <path d="M3 8 L11 9 M3 8 L6 16" stroke="#111" stroke-width="1.5" stroke-linecap="round" />
              </svg>
              <span class="font-script text-[18px] text-ink whitespace-nowrap">
                {c.note}
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
