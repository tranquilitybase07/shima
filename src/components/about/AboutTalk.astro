---
import { talkSubtitle } from "../../data/about";
---

<section class="text-center px-5 pt-16 pb-6 max-w-[620px] mx-auto">
  <div class="flex justify-center mb-6">
    <svg viewBox="0 0 160 160" class="w-[120px] h-[120px]" aria-hidden="true">
      <circle cx="80" cy="80" r="66" fill="#F4C020" stroke="#111" stroke-width="3.5" />
      <ellipse cx="52" cy="98" rx="12" ry="8" fill="#EC1E79" opacity="0.55" />
      <ellipse cx="108" cy="98" rx="12" ry="8" fill="#EC1E79" opacity="0.55" />
      <rect x="54" y="62" width="10" height="20" rx="5" fill="#111" />
      <rect x="96" y="62" width="10" height="20" rx="5" fill="#111" />
      <path
        d="M52,98 C64,116 96,116 108,98"
        fill="none"
        stroke="#111"
        stroke-width="4"
        stroke-linecap="round"
      />
    </svg>
  </div>

  <h2 class="font-display m-0 mb-4" style="font-size:clamp(34px,6vw,60px);">
    LET'S TALK
  </h2>

  <p class="font-script text-[20px] leading-[1.5] text-ink/80 max-w-[420px] mx-auto">
    {talkSubtitle}
  </p>
</section>
