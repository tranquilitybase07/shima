---
import { projects } from "../data/portfolio";
import ImageSlot from "./ImageSlot.astro";
---

<section id="works" class="px-5 pb-[60px] max-w-[1000px] mx-auto">
  {
    projects.map((p) => (
      <article class="sticky mb-[26px]" style={`top:${p.top};`}>
        <div class="flex gap-2 -mb-px pl-[6px]">
          <div
            class="inline-flex items-center gap-[6px] border-[1.5px] border-ink border-b-0 rounded-t-[8px] px-3 py-[5px] font-mono text-[10px] font-bold"
            style={`background:${p.bg};color:${p.fg};`}
          >
            ▤ PROJECT {p.num}
          </div>
        </div>

        <a
          href="/case-study"
          class="grid grid-cols-1 md:grid-cols-[1fr_1.15fr] border-[1.5px] border-ink rounded-[0_12px_12px_12px] overflow-hidden shadow-hard-5 min-h-[360px] hover:opacity-100"
        >
          <div
            class="flex flex-col px-6 py-[26px]"
            style={`background:${p.bg};color:${p.fg};`}
          >
            <div class="font-mono text-[11px] font-bold tracking-[0.08em] mb-auto">
              ● {p.date}
            </div>
            <h3
              class="font-bold m-0 mb-[10px]"
              style="font-size:clamp(28px,3.6vw,44px);"
            >
              {p.title}
            </h3>
            <p class="text-[14px] leading-[1.5] m-0 mb-[18px] max-w-[300px] opacity-90">
              {p.desc}
            </p>
            <span
              class="self-start font-mono text-[11px] font-bold tracking-[0.08em] border-b-[1.5px] border-current pb-[2px]"
            >
              VIEW PROJECT ↗
            </span>
          </div>

          <div class="relative bg-[#e8e8e8] min-h-[240px]">
            <ImageSlot id={p.slot} shape="rect" placeholder="project image" />
            <div class="absolute top-[10px] right-[10px] bg-pink text-paper border-[1.5px] border-ink px-[9px] py-[3px] font-mono text-[9px] font-bold pointer-events-none">
              ▤ IMAGE.JPG
            </div>
            <span class="absolute left-2 top-2 w-3 h-3 border-l-2 border-t-2 border-white pointer-events-none" />
            <span class="absolute left-2 bottom-2 w-3 h-3 border-l-2 border-b-2 border-white pointer-events-none" />
            <span class="absolute right-2 bottom-2 w-3 h-3 border-r-2 border-b-2 border-white pointer-events-none" />
          </div>
        </a>
      </article>
    ))
  }
</section>
