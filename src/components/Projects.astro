---
import { projects } from "../data/portfolio";
import ImageSlot from "./ImageSlot.astro";

// Depth (px) of the tab strip at the top of every card.
const TAB_DEPTH = 100;
// Each card's tab occupies one equal horizontal slot; when the cards stack
// (all sticky at the same top) the tabs line up into a single row.
const SLOT = 100 / projects.length;
---

<section id="works" class="px-[clamp(24px,7vw,140px)] pb-[110px]">
  {
    projects.map((p, i) => {
      const li = i * SLOT; // left start of this tab (%)
      const flatEnd = li + SLOT * 0.82; // end of the flat top (%)
      const diagEnd = li + SLOT; // where the diagonal meets the next tab (%)
      const clip = `polygon(0 ${TAB_DEPTH}px, ${li}% ${TAB_DEPTH}px, ${li}% 0, ${flatEnd}% 0, ${diagEnd}% ${TAB_DEPTH}px, 100% ${TAB_DEPTH}px, 100% 100%, 0 100%)`;
      const href = p.href ?? "/case-study";
      const isExternal = href.startsWith("http");
      return (
        <article class="sticky mb-[40px]" style="top:56px;">
          <a
            href={href}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
            class="relative flex flex-col overflow-hidden min-h-[620px] lg:min-h-[760px] hover:opacity-100"
            style={`background:${p.bg};color:${p.fg};clip-path:${clip};`}
          >
            {/* PROJECT tab label, sitting inside this card's notch */}
            <div
              class="absolute z-10 flex items-center gap-[10px] font-mono font-bold tracking-[0.06em]"
              style={`top:clamp(28px,3vw,40px);left:calc(${li}% + clamp(22px,2.4vw,42px));font-size:clamp(15px,1.4vw,21px);`}
            >
              <span aria-hidden="true">▤</span> PROJECT {p.num}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-[1fr_1.15fr] flex-1 pt-[clamp(96px,9vw,132px)]">
              {/* Left content */}
              <div class="flex flex-col px-[clamp(28px,4vw,64px)] pb-[clamp(30px,4vw,52px)]">
                <div class="font-mono text-[12px] font-bold tracking-[0.08em] mb-5">
                  ● {p.date}
                </div>
                <h3
                  class="font-bold m-0 mb-[18px] leading-[1.02]"
                  style="font-size:clamp(40px,5vw,80px);"
                >
                  {p.title}
                </h3>
                <p class="text-[clamp(15px,1.3vw,18px)] leading-[1.55] m-0 mb-[24px] max-w-[360px] opacity-90">
                  {p.desc}
                </p>
                <span class="self-start font-mono text-[11px] font-bold tracking-[0.08em] border-b-[1.5px] border-current pb-[2px]">
                  VIEW PROJECT ↗
                </span>

                <div class="mt-auto pt-8 flex flex-wrap gap-[12px]">
                  {p.tags.map((t) => (
                    <span
                      class="relative inline-flex items-center font-mono text-[11px] font-bold tracking-[0.06em] px-[14px] py-[8px]"
                      style={`background:#111;color:#fff;border:1.5px solid ${p.fg};`}
                    >
                      <span
                        class="absolute -top-[6px] left-[10px] w-7 h-[6px] rounded-t-[2px]"
                        style="background:#111;"
                      />
                      {t}
                    </span>
                  ))}
                </div>
              </div>

              {/* Image */}
              <div class="relative px-[clamp(16px,2vw,30px)] pb-[clamp(16px,2vw,30px)] md:pl-0">
                <div class="relative h-full min-h-[300px] border-2 border-ink bg-[#e8e8e8]">
                  <ImageSlot id={p.slot} src={p.image} alt={p.imageAlt} shape="rect" placeholder="project image" />
                  <div class="absolute top-[12px] right-[12px] flex items-center gap-[8px] bg-ink text-paper px-[10px] py-[6px] font-mono text-[12px] font-bold pointer-events-none">
                    <span class="bg-blue text-ink px-[5px] py-[1px] rounded-[3px] text-[10px] leading-none">
                      {p.image ? "PNG" : "JPG"}
                    </span>
                    {p.imageLabel ?? "IMAGE.JPG"}
                  </div>
                  <span class="absolute -left-[6px] -top-[6px] w-3 h-3 border-2 border-ink bg-paper pointer-events-none" />
                  <span class="absolute -right-[6px] -top-[6px] w-3 h-3 border-2 border-ink bg-paper pointer-events-none" />
                  <span class="absolute -left-[6px] -bottom-[6px] w-3 h-3 border-2 border-ink bg-paper pointer-events-none" />
                  <span class="absolute -right-[6px] -bottom-[6px] w-3 h-3 border-2 border-ink bg-paper pointer-events-none" />
                </div>
              </div>
            </div>
          </a>
        </article>
      );
    })
  }
</section>
